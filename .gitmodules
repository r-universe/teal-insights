[submodule ".registry"]
	path = .registry
	url = https://github.com/teal-insights/teal-insights.r-universe.dev
	branch = HEAD
[submodule "econid"]
	path = econid
	url = https://github.com/teal-insights/r-econid
[submodule "imfapi"]
	path = imfapi
	url = https://github.com/teal-insights/r-imfapi
[submodule "imfweo"]
	path = imfweo
	url = https://github.com/teal-insights/r-imfweo
[submodule "saisdata"]
	path = saisdata
	url = https://github.com/Teal-Insights/saisdata
	branch = v0.3.0
[submodule "wbids"]
	path = wbids
	url = https://github.com/teal-insights/r-wbids
